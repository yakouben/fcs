# ============================================================================
# SECRETS - Template de fichier de secrets
# ============================================================================
# COPIER ce fichier en secrets.tfvars et remplir les valeurs
# NE JAMAIS commiter secrets.tfvars dans Git !
#
# Pour obtenir vos credentials OVH API :
# 1. Aller sur https://api.ovh.com/createToken/
# 2. Remplir les champs et generer les cles
# 3. Copier les valeurs ci-dessous
# ============================================================================

# --- Credentials OVH API ---
ovh_application_key    = "VOTRE_APPLICATION_KEY"
ovh_application_secret = "VOTRE_APPLICATION_SECRET"
ovh_consumer_key       = "VOTRE_CONSUMER_KEY"

# --- ID Projet Public Cloud ---
# Visible dans le Manager OVH > Public Cloud > votre projet
ovh_cloud_project_id = "VOTRE_PROJECT_ID"

# --- Configuration (optionnel - valeurs par defaut utilisees sinon) ---
# project_name = "frigoclimat"
# domain_name  = "frigoclimat.fr"
# region       = "GRA"
# environment  = "prod"
